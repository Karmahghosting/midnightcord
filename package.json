{
    "name": "midnightcord",
    "private": "true",
    "version": "1.27.9",
    "desktopName": "midnightcord.desktop",
    "description": "A fast cross-platform Discord client mod with native voice",
    "main": "dist/js/main.js",
    "homepage": "https://github.com/Karmahghosting/midnightcord",
    "bugs": {
        "url": "https://github.com/Karmahghosting/midnightcord/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Karmahghosting/midnightcord.git"
    },
    "license": "GPL-3.0-or-later",
    "author": "Midnightcord contributors",
    "scripts": {
        "build": "corepack pnpm depCheck && corepack pnpm generatePluginJson && node --require=./scripts/suppressExperimentalWarnings.js scripts/build/build.mjs",
        "buildStandalone": "corepack pnpm build --standalone",
        "buildStandalone:linux": "corepack pnpm build --standalone --disable-updater",
        "buildDesktop": "tsx scripts/build/buildDesktop.mts",
        "package": "corepack pnpm package:native",
        "package:linux": "corepack enable --install-directory node_modules/.bin && corepack pnpm run buildDesktop && corepack pnpm run buildStandalone:linux && node scripts/packageLinux.mjs",
        "package:linux:x64": "corepack enable --install-directory node_modules/.bin && corepack pnpm run buildDesktop && corepack pnpm run buildStandalone:linux && node scripts/packageLinux.mjs --x64",
        "package:linux:rpm": "node scripts/packageLinux.mjs --x64 --rpm",
        "package:linux:arm64": "corepack enable --install-directory node_modules/.bin && corepack pnpm run buildDesktop && corepack pnpm run buildStandalone:linux && node scripts/packageLinux.mjs --arm64",
        "package:dir": "corepack enable --install-directory node_modules/.bin && corepack pnpm run buildDesktop && corepack pnpm run buildStandalone:linux && node scripts/packageLinux.mjs --dir",
        "buildWeb": "node --require=./scripts/suppressExperimentalWarnings.js scripts/build/buildWeb.mjs",
        "buildWebStandalone": "pnpm buildWeb --standalone",
        "buildReporter": "pnpm buildWebStandalone --reporter --skip-extension",
        "buildReporterDesktop": "pnpm build --reporter",
        "start": "pnpm run buildDesktop && pnpm run buildStandalone && electron .",
        "start:dev": "pnpm run buildDesktop --dev && pnpm run buildStandalone && electron .",
        "watch": "pnpm build --watch",
        "dev": "pnpm watch",
        "watchWeb": "pnpm buildWeb --watch",
        "generateDevsList": "tsx scripts/generateDevsList.ts",
        "generatePluginJson": "tsx scripts/generatePluginList.ts --midnightcord plugins.json",
        "generateEquicordPluginJson": "tsx scripts/generatePluginList.ts --equicord plugins.json",
        "generateVencordPluginJson": "tsx scripts/generatePluginList.ts --vencord plugins.json",
        "generateTypes": "tspc --emitDeclarationOnly --declaration --outDir packages/vencord-types --allowJs false",
        "inject": "node scripts/inject.mjs",
        "inject:linux": "node scripts/inject.mjs",
        "uninject": "node scripts/uninject.mjs",
        "uninject:linux": "node scripts/uninject.mjs",
        "repair": "node scripts/inject.mjs",
        "lint": "eslint",
        "lint-styles": "stylelint \"src/**/*.css\" --ignore-pattern src/userplugins",
        "lint:fix": "pnpm lint --fix",
        "test": "pnpm buildStandalone && pnpm testTsc && pnpm lint:fix && pnpm lint-styles && pnpm generatePluginJson",
        "testWeb": "pnpm lint:fix && pnpm buildWeb && pnpm testTsc",
        "testTsc": "tsc --noEmit",
        "depCheck": "node scripts/depCheck.mjs",
        "package:native": "corepack enable --install-directory node_modules/.bin && corepack pnpm build --standalone && node scripts/packageNative.mjs",
        "package:update": "corepack enable --install-directory node_modules/.bin && corepack pnpm build --standalone && node scripts/packageUpdate.mjs",
        "package:all": "corepack pnpm run package:native && corepack pnpm run package:linux",
        "inject:native": "node scripts/inject.mjs",
        "inject:windows": "node scripts/inject.mjs",
        "inject:macos": "node scripts/inject.mjs",
        "uninject:native": "node scripts/uninject.mjs",
        "uninject:windows": "node scripts/uninject.mjs",
        "uninject:macos": "node scripts/uninject.mjs",
        "test:native-injection": "node scripts/testNativeInjection.mjs",
        "test:privacy": "node scripts/testPrivacy.mjs"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "^0.12.10",
        "@ffmpeg/util": "^0.12.1",
        "@intrnl/xxhash64": "^0.1.2",
        "@song-spotlight/api": "^2.0.1",
        "@streamparser/json": "^0.0.22",
        "@types/less": "^3.0.8",
        "@types/stylus": "^0.48.42",
        "@types/tinycolor2": "^1.4.6",
        "@vap/core": "0.0.12",
        "@vap/shiki": "0.10.5",
        "discord": "^0.8.2",
        "fflate": "^0.8.2",
        "fix-webm-duration": "^1.0.6",
        "gifenc": "github:mattdesl/gifenc#64842fca317b112a8590f8fef2bf3825da8f6fe3",
        "idb": "8.0.3",
        "jsqr": "1.4.0",
        "monaco-editor": "^0.54.0",
        "nanoid": "^5.1.6",
        "native-file-system-adapter": "^3.0.1",
        "usercss-meta": "^0.12.0",
        "virtual-merge": "^1.0.1",
        "yaml-js": "^0.3.1"
    },
    "devDependencies": {
        "@electron/asar": "^4.0.1",
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@stylistic/eslint-plugin": "^5.6.0",
        "@types/adm-zip": "^0.5.7",
        "@types/chrome": "^0.1.30",
        "@types/diff": "^7.0.2",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.10.1",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@types/yazl": "^3.3.0",
        "@vencord/discord-types": "link:packages/discord-types",
        "app-builder-lib": "^26.8.1",
        "arrpc-bun": "^1.3.5",
        "diff": "^8.0.2",
        "dotenv": "^17.3.1",
        "electron": "^42.7.1",
        "electron-builder": "^26.8.1",
        "electron-updater": "^6.8.3",
        "esbuild": "^0.27.0",
        "eslint": "9.39.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-header": "^1.2.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.3.0",
        "highlight.js": "11.11.1",
        "html-minifier-terser": "^7.2.0",
        "javascript-obfuscator": "^5.4.1",
        "minimatch": "^10.2.4",
        "moment": "^2.22.2",
        "puppeteer-core": "^24.30.0",
        "rcedit": "^5.0.2",
        "source-map-support": "^0.5.21",
        "standalone-electron-types": "^34.2.0",
        "stylelint": "^16.25.0",
        "stylelint-config-standard": "^39.0.1",
        "ts-patch": "^3.3.0",
        "ts-pattern": "^5.6.0",
        "tsx": "^4.20.6",
        "type-fest": "^5.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.47.0",
        "typescript-transform-paths": "^3.5.5",
        "ws": "^8.20.0",
        "zip-local": "^0.3.5"
    },
    "packageManager": "pnpm@10.30.3",
    "pnpm": {
        "patchedDependencies": {
            "@types/less@3.0.8": "patches/@types__less@3.0.8.patch"
        },
        "peerDependencyRules": {
            "ignoreMissing": [
                "eslint-plugin-import",
                "eslint"
            ]
        },
        "allowedDeprecatedVersions": {
            "source-map-resolve": "*",
            "resolve-url": "*",
            "source-map-url": "*",
            "urix": "*",
            "q": "*"
        },
        "onlyBuiltDependencies": [
            "esbuild"
        ],
        "overrides": {
            "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
            "@electron/asar>minimatch": "^10.2.4",
            "html-minifier-terser>clean-css": "^5.3.3"
        }
    },
    "engines": {
        "node": ">=18"
    }
}

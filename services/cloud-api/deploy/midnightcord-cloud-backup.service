[Unit]
Description=Backup encrypted Midnightcord Cloud data
After=midnightcord-cloud-api.service

[Service]
Type=oneshot
User=midnightcord-cloud
Group=midnightcord-cloud
Environment=DATA_DIR=/var/lib/midnightcord-cloud
Environment=BACKUP_DIR=/var/backups/midnightcord-cloud
ExecStart=/bin/sh /opt/midnightcord-cloud/current/deploy/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/midnightcord-cloud /var/backups/midnightcord-cloud
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
